iv><div class=\"hero-media\"><img src=\"hero.jpg\" alt=\"Мясо с зеленью — иллюстрация Jez Timms\" fetchpriority=\"high\" width=\"1800\" height=\"1200\"><div class=\"stamp\" data-t=\"stamp\"></div><div class=\"photo-caption\" data-t=\"photo\"></div></div></section>\n<div class=\"ticker\"><span data-t=\"tick1\"></span><span data-t=\"tick2\"></span><span data-t=\"tick3\"></span></div>\n<section class=\"section\" id=\"catalog\"><div class=\"section-title\"><div><div class=\"eyebrow\" data-t=\"selection\"></div><h2 data-t=\"catalogtitle\"></h2></div><input type=\"search\" class=\"search\" id=\"search\" oninput=\"renderProducts()\" aria-label=\"Поиск\"></div><div class=\"filters\" id=\"filters\"></div><div class=\"grid\" id=\"products\"></div><p class=\"small\" data-t=\"prices\"></p></section>\n<section class=\"section bundles\" id=\"sets\"><div class=\"section-title\"><div><div class=\"eyebrow\" data-t=\"together\"></div><h2 data-t=\"settitle\"></h2></div><p data-t=\"setdesc\"></p></div><div class=\"bundle-grid\"></div>\n</section>\n<section class=\"section story\" id=\"how\"><div><figure class=\"process-figure\"><img class=\"story-photo\" src=\"/photos/preparation-v5.jpg\" alt=\"Руки за подготовкой свежих ингредиентов на деревянной доске\" loading=\"lazy\" width=\"1400\" height=\"933\"><figcaption data-art=\"processPhoto\"></figcaption></figure><div class=\"eyebrow\" data-t=\"care\"></div><h2 data-art=\"process\"></h2><p class=\"muted\" data-art=\"processBody\"></p></div><ol><li><span>01</span><p><strong data-t=\"step1\"></strong><span class=\"small\" data-t=\"step1desc\"></span></p></li><li><span>02</span><p><strong data-t=\"step2\"></strong><span class=\"small\" data-t=\"step2desc\"></span></p></li><li><span>03</span><p><strong data-t=\"step3\"></strong><span class=\"small\" data-t=\"step3desc\"></span></p></li></ol></section>\n<section class=\"section faq\"><div class=\"eyebrow\" data-t=\"answers\"></div><h2 data-t=\"faq\"></h2><details><summary data-t=\"q1\"></summa