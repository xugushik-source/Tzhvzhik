,'Ախալքալաք'][['ru','ka','hy'].indexOf(state.lang)]+' ⌄';$('lang').textContent=state.lang.toUpperCase()+' ⌄';$('search').placeholder=t('search');$('search').setAttribute('aria-label',t('search'));document.querySelector('.close').setAttribute('aria-label',['Закрыть','დახურვა','Փակել'][['ru','ka','hy'].indexOf(state.lang)]);$('filters').innerHTML=['all','pork','beef','lamb','chicken','ready','sides','wine','cheese','favs'].map(c=>`<button class=\"chip ${category===c?'active':''}\" onclick=\"filter('${c}')\" aria-pressed=\"${category===c}\">${t(c)}</button>`).join('');renderProducts();updateCart()}\nfunction filter(c){category=c;render()}\nfunction renderProducts(){const q=$('search').value.toLocaleLowerCase();const list=products.filter(p=>p.active!==0&&(category==='all'||category==='favs'&&state.favs.includes(p.id)||category===p.cat)&&name(p).toLocaleLowerCase().includes(q));$('products').innerHTML=list.length?list.map(p=>`<article class=\"product reveal\"><div class=\"media\"><span class=\"cut\">${p.symbol}</span><span class=\"ph\">Фото товара</span><button class=\"favorite ${state.favs.includes(p.id)?'on':''}\" aria-label=\"${t('favs')}: ${esc(name(p))}\" aria-pressed=\"${state.favs.includes(p.id)}\" onclick=\"favorite('${p.id}')\">${state.favs.includes(p.id)?'♥':'♡'}</button></div><div class=\"product-meta\">${t(p.cat)}</div><h3>${esc(name(p))}</h3><div class=\"product-bottom\"><span>${money(p.price)} / ${p.unit==='kg'?['кг','კგ','կգ'][['ru','ka','hy'].indexOf(state.lang)]:'1'}</span><button class=\"add\" aria-label=\"${t('add')}: ${esc(name(p))}\" onclick=\"productSheet('${p.id}')\">+</button></div></article>`).join(''):`<p>${t('empty')}</p>`;}\nfunction favorite(id){state.favs=state.favs.includes(id)?state.favs.filter(x=>x!==id):[...state.favs,id];save();renderProducts()}\nfunction updateCart(){const n=state.cart.length;$('cart-button').textContent=t('cart')+' · '+n;$('mini').classList.toggle('visible',n>0);$('mini').innerHTML=`<span>${t('cart')} · ${n}</span><span>${money(totalCents()/100)}</span>`}\nfunction openSheet(title,html){if(!$('overlay').classList.contains('open'))focusBack=document.activeElement;$('drawer-title').textContent=title;$('drawer-content').innerHTML=html;$('overlay').classList.add('open');document.body.style.overflow='hidden';document.querySelector('.drawer').focus()}\nfunction closeSheet(){$('overlay').classList.remove('open');document.body.style.overflow='';focusBack?.focus()}\n$('overlay').addEventListener('click',e=>{if(e.target===$('overlay'))closeSheet()});document.addEventListener('keydown',e=>{if(!$('overlay').classList.contains('open'))return;if(e.key==='Escape')closeSheet();if(e.key==='Tab'){const f=[...document.querySelector('.drawer').querySelectorAll('button:not([disabled]),a,input,select,[tabindex=\"0\"]')];if(!f.length)return;const first=f[0],last=f.at(-1);if(e.shiftKey&&(document.activeElement===first||document.activeElement===document.querySelector('.drawer'))){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}});\nfunction languageSheet(){openSheet(t('lang'),['ru','ka','hy'].map((l,i)=>`<button class=\"row plain\" style=\"width:100%\" onclick=\"setLang('${l}')\"><span>${['Русский','ქართული','Հայերեն'][i]}</span><span>${l===state.lang?'✓':''}</span></button>`).join(''))}\nfunction setLang(l){state.lang=l;save();closeSheet();render()}\nfunction citySheet(){openSheet(t('city'),`<div class=\"row\">${$('city').textContent} <span>✓</span></div><div class=\"row muted\">${['Ниноцминда','ნინოწმინდა','Նինոծմինդա'][['ru','ka','hy'].indexOf(state.lang)]}<span>${t('soon')}</span></div><div class=\"row muted\">${['Ахалцихе','ახალციხე','Ախալցխա'][['ru','ka','hy'].indexOf(state.lang)]}<span>${t('soon')}</span></div><p class=\"warn\">${t('a1')}</p>`)}\nfunction productSheet(id){const p=pget(id);openSheet(name(p),`<div class=\"small\">${money(p.price)} / ${p.unit==='kg'?'kg':'1'}</div><label for=\"qty\">${t(p.unit==='kg'?'weight':'amount')}</label><input id=\"qty\" type=\"number\" min=\"${p.unit==='kg'?.1:1}\" max=\"30\" step=\"${p.unit==='kg'?.1:1}\" value=\"1\">${p.prep?`<label for=\"prep\">${t('prep')}</label><select id=\"prep\"><option value=\"piece\">${t('piece')}</option><option value=\"cut\">${t('cut')}</option><option value=\"mince\">${t('mince')}</option></select>`:''}<p class=\"warn\">${t('note')} ${t('prices')}</p><button class=\"cta\" onclick=\"addFromSheet('${p.id}')\">${t('add')}</button>`)}\nfunction addLine(id,qty,prep='piece',bundle=''){if(!pget(id)||pget(id).active===0||!Number.isFinite(qty)||qty<=0||qty>30)return false;const step=pget(id).unit==='kg'?10:1;if(Math.abs(qty*step-Math.round(qty*step))>.00001)return false;const exists=state.cart.find(x=>x.id===id&&x.prep===prep&&x.bundle===bundle);if(exists){if(exists.qty+qty>30)return false;exists.qty=Math.round((exists.qty+qty)*10)/10}else state.cart.push({id,qty,prep,bundle});save();updateCart();return true}\nfunction addFromSheet(id){if(addLine(id,Number($('qty').value),$('prep')?.value||'piece')){closeSheet();toast(t('saved'))}else $('qty').reportValidity()}\nfunction bundleSheet(kind){const ids=kind==='bbq'?['neck','sauce','lavash']:['cutlets','sauce','lavash'];const qtys=kind==='bbq'?[2,1,2]:[1,1,2];openSheet(t(kind==='bbq'?'bbqset':'dinnerset'),`<p class=\"small\">${t('bundle')} · DEMO</p>`+ids.map((id,i)=>`<label for=\"b-${id}\">${name(pget(id))} · ${money(pget(id).price)}</label><input id=\"b-${id}\" type=\"number\" min=\"0\" max=\"30\" step=\"${pget(id).unit==='kg'?.1:1}\" value=\"${qtys[i]}\">`).join('')+`<div class=\"row\"><span>${t('total')}</span><strong id=\"bundle-sum\"></strong></div><button class=\"cta\" onclick=\"addBundle('${kind}')\">${t('add')}</button>`);document.querySelectorAll('[id^=\"b-\"]').forEach(el=>el.addEventListener('input',bundleTotal));bundleTotal()}\nfunction bundleTotal(){const cents=[...document.querySelectorAll('[id^=\"b-\"]')].reduce((s,e)=>s+Math.round(pget(e.id.slice(2)).price*100*(Number(e.value)||0)),0);$('bundle-sum').textContent=money(cents/100)}\nfunction addBundle(kind){const inputs=[...document.querySelectorAll('[id^=\"b-\"]')];if(inputs.some(e=>!e.checkValidity())){inputs.find(e=>!e.checkValidity()).reportValidity();return}const selected=inputs.filter(e=>Number(e.value)>0);if(!selected.length)return;const before=JSON.stringify(state.cart);for(const el of selected){if(!addLine(el.id.slice(2),Number(el.value),'piece',kind)){state.cart=JSON.parse(before);save();updateCart();return}}closeSheet();toast(t('saved'))}\nfunction changeQty(i,delta){const x=state.cart[i];const step=pget(x.id).unit==='kg'?.1:1;const value=Math.round((x.qty+delta*step)*10)/10;if(value>30)return;if(value<=0)state.cart.splice(i,1);else x.qty=value;save();updateCart();cartSheet()}\nfunction removeLine(i){state.cart.splice(i,1);save();updateCart();cartSheet()}\nfunction cartSheet(){if(!state.cart.length){openSheet(t('cart'),`<p class=\"empty\">${t('empty')}</p><button class=\"cta\" onclick=\"closeSheet();document.getElementById('catalog').scrollIntoView()\">${t('choose')}</button>`);return}const total=totalCents();const sides=products.filter(p=>p.cat==='sides'&&!state.cart.some(x=>x.id===p.id));openSheet(t('cart'),state.cart.map((x,i)=>`<div class=\"row\"><div><strong>${name(pget(x.id))}</strong><div class=\"small\">${x.qty} ${pget(x.id).unit==='kg'?'kg':''} · ${t(x.prep)}${x.bundle?' · '+t('sets'):''}</div><button class=\"plain small\" onclick=\"removeLine(${i})\">${t('remove')}</button></div><div><span>${money(lineTotal(x)/100)}</span><div class=\"quantity\"><button aria-label=\"−\" onclick=\"changeQty(${i},-1)\">−</button><button aria-label=\"+\" onclick=\"changeQty(${i},1)\">+</button></div></div></div>`).join('')+`<div class=\"warn\">${total>=10000?t('giftready'):t('gift')+' · '+money((10000-total)/100)}<progress max=\"10000\" value=\"${Math.min(total,10000)}\"></progress></div>${sides.length?`<h3>${t('more')}</h3>`+sides.map(p=>`<button class=\"row plain\" style=\"width:100%\" onclick=\"addLine('${p.id}',1);cartSheet()\"><span>${name(p)} · ${money(p.price)}</span><span>+</span></button>`).join(''):''}<div class=\"row\"><span>${t('total')}</span><strong>${money(total/100)}</strong></div><p class=\"small\">${t('prices')}</p><button class=\"cta\" onclick=\"checkoutSheet()\">${t('checkout')}</button>`)}\nfunction checkoutSheet(){if(!state.cart.length)return cartSheet();openSheet(t('checkout'),`<div class=\"warn\">${t('testonly')}</div><div class=\"row\"><span>${t('city')}</span><span>${$('city').textContent}</span></div><div class=\"row\"><span>DEMO</span><span>Guest · Demo address</span></div><label for=\"method\">${t('method')}</label><select id=\"method\" onchange=\"activeMethod=this.value;paymentSummary()\"><option value=\"cash\">${t('cash')}</option><option value=\"geo\">${t('geo')}</option><option value=\"russia\">${t('russia')}</option></select><div id=\"payment-summary\"></div><p class=\"small\">${t('proofnote')}</p><button class=\"cta\" id=\"submit\" onclick=\"createDemoOrder()\"></button>`);$('method').value=activeMethod;paymentSummary()}\nfunction paymentSummary(){const v=pricing(totalCents(),activeMethod);$('payment-summary').innerHTML=`<div class=\"row\"><span>${t('base')}</span><span>${money(v.items/100)}</span></div><div class=\"row\"><span>${t('delivery')}</span><span>0.00 ₾</span></div>${activeMethod==='russia'?`<div class=\"row\"><span>${t('extra')} ${state.extra}%</span><span>${money(v.surcharge/100)}</span></div><p class=\"small\">${t('rate')}: 1 GEL = ${state.rate} RUB · DEMO</p>`:''}<div class=\"row\"><strong>${t('total')}</strong><strong>${money(v.gel/100)}</strong></div>${activeMethod==='russia'?`<div class=\"row\"><strong>${t('rub')}</strong><strong>${(v.rub/100).toFixed(2)} ₽</strong></div>`:''}`;$('submit').textContent=t(activeMethod==='cash'?'submit':'proof')}\nconst labels={NEW:'orders',PAYMENT_REVIEW_REQUIRED:'pending',CONFIRMED:'confirmed',PREPARING:'preparing',READY:'readyStatus',DELIVERED:'delivered',CANCELLED:'cancelled'};\nfunction serverRequired(){toast(['Запустите проект через run.py','გაუშვით პროექტი run.py-ით','Գործարկեք նախագիծը run.py-ով'][['ru','ka','hy'].indexOf(state.lang)])}\nfunction createDemoOrder(){serverRequired()}\nfunction ordersSheet(){serverRequired()}\nfunction adminSheet(){serverRequired()}\nfunction changeStatus(){serverRequired()}\nfunction saveSettings(){serverRequired()}\nrender();\n</script><script src=\"server-ui.js?v=10\"></script><script src=\"weighted-ui.js?v=8\"></script><script src=\"/hosted-ui.js?v=10\"></script><script src=\"/meal-engine.js?v=10\"></script><script src=\"/pairing-engine.js?v=10\"></script><script src=\"/atelier.js?v=10\"></script><script src=\"/meal-ui.js?v=10\"></script><script src=\"/pairing-ui.js?v=10\"></script></body></html>\n"